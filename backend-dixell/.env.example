PORT=3001
MODBUS_DEVICE_PORT=502
MODBUS_TIMEOUT_MS=1500
MONGODB_URI=mongodb+srv://user:pass@cluster.host/?retryWrites=true&w=majority
MONGODB_DB_NAME=tecnitower
MONGODB_TIMEOUT_MS=5000
NODE_ENV=development
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=3600
MQTT_URL=mqtts://your-broker.example.com:8883
MQTT_USERNAME=tecnitower
MQTT_PASSWORD=change-me
BACKEND_MQTT_CLIENT_ID=tecnitower-api-local
MQTT_TOPIC=tecnitower/elfins/+/data
MQTT_ACK_TOPIC=tecnitower/elfins/+/ack
MQTT_RECONNECT_MS=3000
MQTT_COMMAND_TIMEOUT_MS=30000

# Valor por defecto del backend. Si un controlador tiene `gatewayMode` guardado,
# ese valor tiene prioridad y este .env queda solo como fallback.
# direct = backend escribe Modbus directo por IP local.
# agent-mqtt/mqtt/cloud = backend cloud publica JSON MQTT y un agente local/Raspberry escribe por Elfin.
# elfin-mqtt = backend publica tramas Modbus RTU binarias al gateway por MQTT. Experimental: requiere gateway compatible con bidireccionalidad MQTT/Modbus.
CONTROL_TRANSPORT=direct
MQTT_RAW_COMMAND_TOPIC_SUFFIX=tx
MQTT_RAW_RESPONSE_TOPIC_SUFFIX=rx

# Variables usadas por `npm run agent:local` en la maquina local/Raspberry.
LOCAL_AGENT_MQTT_CLIENT_ID=tecnitower-agent-2018DP1893
LOCAL_AGENT_ELFIN_ID=2018DP1893
LOCAL_AGENT_MODBUS_HOST=192.168.100.55
LOCAL_AGENT_MODBUS_PORT=502
LOCAL_AGENT_UNIT_ID=1
