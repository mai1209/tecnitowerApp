PORT=3001
HOST=0.0.0.0
NODE_ENV=production

MONGODB_URI=mongodb+srv://user:pass@cluster.host/?retryWrites=true&w=majority
MONGODB_DB_NAME=tecnitower
MONGODB_TIMEOUT_MS=5000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800

MQTT_URL=mqtts://your-broker.example.com:8883
MQTT_USERNAME=tecnitower
MQTT_PASSWORD=replace-with-broker-password
BACKEND_MQTT_CLIENT_ID=tecnitower-api-production
MQTT_TOPIC=tecnitower/elfins/+/data
MQTT_ACK_TOPIC=tecnitower/elfins/+/ack
MQTT_RECONNECT_MS=3000
MQTT_COMMAND_TIMEOUT_MS=30000

# Fallback global del backend. Si el controlador tiene `gatewayMode`,
# ese valor tiene prioridad.
CONTROL_TRANSPORT=agent-mqtt

# Solo usar si se valida gateway MQTT directo compatible.
MQTT_RAW_COMMAND_TOPIC_SUFFIX=tx
MQTT_RAW_RESPONSE_TOPIC_SUFFIX=rx

# No se usan en el backend cloud, pero se dejan documentadas por referencia.
LOCAL_AGENT_MQTT_CLIENT_ID=tecnitower-agent-2018DP1893
LOCAL_AGENT_ELFIN_ID=2018DP1893
LOCAL_AGENT_MODBUS_HOST=192.168.100.55
LOCAL_AGENT_MODBUS_PORT=502
LOCAL_AGENT_UNIT_ID=1
